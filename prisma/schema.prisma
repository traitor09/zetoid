datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id        String    @id @default(cuid())
  title     String
  dueDate   DateTime?
  priority  Int       @default(3)   // 1=high, 3=medium, 5=low
  tags      String   @default("[]")
  done      Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
